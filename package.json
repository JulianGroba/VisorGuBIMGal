    "leaflet": "1.9.4",
    "proj4": "2.15.0"
  },
  "devDependencies": {
    "@types/leaflet": "1.9.20",
    "@types/proj4": "2.5.6",
    "typescript": "5.9.3",
    "vite": "7.3.7"
